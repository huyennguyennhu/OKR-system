# ==========================================
# OKR System - Git Ignore Rules
# ==========================================

# 1. Private / Ignored Documentation & Extraction Files (Requested by User)
ACTIVEPIECES_GUIDE.md
CAU_HINH_ACTIVEPIECES_KR_A1.md
README.md
unique_urls.txt

# 2. Private HAR Network Archives (Cookies, Session IDs, Production Tokens)
har_private/
**/har_private/
*.har
**/*.har

# 3. Environment Variables & Secret Credentials
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example

# 4. Dependencies
node_modules/
**/node_modules/
package-lock.json.backup
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Local Database Files & SQLite
*.db
*.sqlite
*.sqlite3
**/okr_data.db
**/*.db
**/*.sqlite
**/*.sqlite3

# 6. Angular & Frontend Build Artefacts
.angular/
**/.angular/
dist/
**/dist/
out-tsc/
**/out-tsc/
.tmp/
**/.tmp/

# 7. Operating System & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
**/.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sw?
*~

# 8. Runtime Logs & Caches
logs/
*.log
.eslintcache
